Output kcatcher-demo.gif

Set WindowBar Colorful
Set CursorBlink true
Set Margin 20
Set MarginFill "#3D4F5F"
Set TypingSpeed 75ms
Set Theme "Monokai Vivid"
Set Padding 12
Set PlaybackSpeed 1
Set BorderRadius 10
Set Width 1300
Set Height 650
Set FontSize 14

Type "kcatcher -b 54.166.80.187 --sample-topic connect-offsets --sample-count 1"
Sleep 1s
Enter
Sleep 4s
